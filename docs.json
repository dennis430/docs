{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Ultiwrite Docs",
  "colors": {
    "primary": "#D39891",
    "light": "#E7B7B0",
    "dark": "#9A645E"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart",
          "api-keys"
        ]
      },
      {
        "group": "Partner API",
        "pages": [
          "partner-api/overview",
          "partner-api/authentication",
          "partner-api/workflow",
          "partner-api/uploads",
          "partner-api/results",
          "partner-api/usage",
          "partner-api/errors-and-retries",
          "partner-api/integration-checklist"
        ]
      },
      {
        "group": "API reference",
        "pages": [
          "api-contract",
          "api-reference/account",
          "api-reference/capabilities",
          "api-reference/usage",
          "api-reference/list-cases",
          "api-reference/submit-evidence",
          "api-reference/case-status",
          "api-reference/continue-case",
          "api-reference/case-findings",
          "api-reference/case-brief",
          "api-reference/report-findings",
          "api-reference/report-brief",
          "api-reference/report-delivery",
          "api-reference/upload-link"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "API reference",
          "icon": "code",
          "href": "https://dwsoffshorepartners.com/docs/api"
        },
        {
          "anchor": "Product documentation",
          "icon": "book-open",
          "href": "https://dwsoffshorepartners.com/docs"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "href": "https://dwsoffshorepartners.com/docs/api",
        "label": "API reference"
      },
      {
        "label": "Support",
        "href": "https://dwsoffshorepartners.com/contact"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dwsoffshorepartners.com/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
  },
  "description": "Integrate Ultiwrite investigative intelligence with approved API keys, OAuth and resumable evidence-to-report workflows.",
  "search": {
    "prompt": "Search Ultiwrite API docs"
  },
  "api": {
    "openapi": "https://dwsoffshorepartners.com/.well-known/openapi.json",
    "playground": {
      "display": "simple",
      "proxy": false
    },
    "examples": {
      "languages": [
        "bash",
        "javascript",
        "python"
      ],
      "prefill": false,
      "autogenerate": true
    }
  }
}
